# ===========================================
# Narada AI - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://narada_user:your_password@localhost:5432/narada_db

# Individual PostgreSQL connection details (optional, used by some tools)
PGHOST=localhost
PGPORT=5432
PGUSER=narada_user
PGPASSWORD=your_password
PGDATABASE=narada_db

# ===========================================
# SESSION CONFIGURATION
# ===========================================
# Secret key for encrypting sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Must be at least 32 characters for security
SESSION_SECRET=your-super-secret-session-key-at-least-32-characters-long

# ===========================================
# GOOGLE OAUTH 2.0
# ===========================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add authorized JavaScript origins:
#    - http://localhost:5000 (development)
#    - https://your-domain.com (production)
# 3. Add authorized redirect URIs:
#    - http://localhost:5000/api/callback (development)
#    - https://your-domain.com/api/callback (production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ===========================================
# OPENAI CONFIGURATION
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# APPLICATION SETTINGS
# ===========================================
# Set to 'production' in production environment
# This enables secure cookies and other security features
NODE_ENV=development

# Server port (default: 5000)
# PORT=5000
